# =========================================================================
# NovaQuest - Backend Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# =========================================================================

# ---------------------------------------------------------------------------
# Railway / Production deployment
# ---------------------------------------------------------------------------
# Your Vercel frontend URL (no trailing slash). Used to allow CORS from production.
FRONTEND_URL=https://your-project.vercel.app

# Port the Flask server listens on (Railway sets this automatically).
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection URL.
# If unset or unreachable, the backend falls back to local SQLite for development.
DATABASE_URL=postgresql://your_db_user:your_db_password@host:5432/space_hardware

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_DEBUG=0
FLASK_ENV=production

# ---------------------------------------------------------------------------
# CORS (comma-separated list of allowed origins; FRONTEND_URL is always added)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_RPM=120
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Optional: NASA Open Data API Key
# ---------------------------------------------------------------------------
NASA_API_KEY=DEMO_KEY

# ---------------------------------------------------------------------------
# NovaBase ingestion (Wikipedia + NASA GitHub)
# ---------------------------------------------------------------------------
NOVABASE_CONTACT_EMAIL=your-email@example.com
# Optional: avoids GitHub's 60 req/hour anonymous rate limit
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# NovaUser Authentication (JWT + PostgreSQL)
# ---------------------------------------------------------------------------
NOVAUSER_DATABASE_URL=postgresql://novauser:your_password@host:5432/novauser
NOVAUSER_JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters-long
NOVAUSER_JWT_ISSUER=novauser
NOVAUSER_JWT_AUDIENCE=novauser-web
NOVAUSER_TOKEN_EXPIRE_MINUTES=60
NOVAUSER_COOKIE_NAME=novauser_token
NOVAUSER_COOKIE_SECURE=true
NOVAUSER_COOKIE_SAMESITE=None
NOVAUSER_CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# ---------------------------------------------------------------------------
# Firebase Authentication (primary identity provider)
# The backend only needs FIREBASE_PROJECT_ID to verify ID tokens.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
