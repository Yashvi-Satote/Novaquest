# =========================================================================
# Space Hardware Explorer - Environment Configuration Template
# =========================================================================

# Database Configuration
# PostgreSQL Connection URL (Format: postgresql://<username>:<password>@<host>:<port>/<database_name>)
# If unset or unreachable, the system will transparently use local SQLite for development.
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/space_hardware

# Backend Server Configuration
PORT=5000
FLASK_DEBUG=True
FLASK_ENV=development

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173

# Optional: NASA Open Data API Key (if extending live queries)
NASA_API_KEY=DEMO_KEY

# ----------------------------------------------------------------------------
# NovaUser Authentication (JWT + PostgreSQL)
# ----------------------------------------------------------------------------
NOVAUSER_DATABASE_URL=postgresql://novauser:your_password@localhost:5432/users.db
NOVAUSER_JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters-long
NOVAUSER_JWT_ISSUER=novauser
NOVAUSER_JWT_AUDIENCE=novauser-web
NOVAUSER_TOKEN_EXPIRE_MINUTES=60
NOVAUSER_COOKIE_NAME=novauser_token
NOVAUSER_COOKIE_SECURE=false
NOVAUSER_COOKIE_SAMESITE=Lax
NOVAUSER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------------------
# Firebase Authentication (primary identity provider)
# The backend only needs the project ID to verify Firebase ID tokens against
# Google's published certificates. Copy the same web config to frontend/.env
# using the VITE_FIREBASE_* names. Never commit real values.
# ----------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional overrides for the backend verifier
# NOVAUSER_FIREBASE_PROJECT_ID=
# NOVAUSER_FIREBASE_API_KEY=
# NOVAUSER_FIREBASE_AUTH_DOMAIN=
