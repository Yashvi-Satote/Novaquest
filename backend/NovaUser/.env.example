# -----------------------------------------------------------------------------
# NovaUser Authentication - Environment Configuration Template
# -----------------------------------------------------------------------------

# PostgreSQL connection string for the NovaUser database.
# The database name must be "users.db" as requested.
NOVAUSER_DATABASE_URL=postgresql://novauser:change-me@localhost:5432/users.db

# JWT configuration (never commit real values)
NOVAUSER_JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters-long
NOVAUSER_JWT_ISSUER=novauser
NOVAUSER_JWT_AUDIENCE=novauser-web
NOVAUSER_TOKEN_EXPIRE_MINUTES=60

# HTTP-only cookie settings
NOVAUSER_COOKIE_NAME=novauser_token
NOVAUSER_COOKIE_SECURE=false
NOVAUSER_COOKIE_SAMESITE=Lax

# CORS
NOVAUSER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Authentication (required for server-side ID-token verification)
# The project ID is enough: the backend verifies tokens with Google's public
# certificates and never needs a service-account private key.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional aliases
# NOVAUSER_FIREBASE_PROJECT_ID=your-firebase-project-id
# NOVAUSER_FIREBASE_API_KEY=your-web-api-key
