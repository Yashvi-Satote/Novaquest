# Frontend environment template
# Copy to .env and fill in values. Vite exposes only VITE_* variables to the browser.

# ---------------------------------------------------------------------------
# Backend API URL (used by vite.config.js proxy in dev; consumed by the app in prod)
# In production (Vercel) set this to your Railway backend URL, e.g.:
#   VITE_API_URL=https://novaquest-backend.up.railway.app
# Leave blank or omit for local development (defaults to http://localhost:5000)
# ---------------------------------------------------------------------------
VITE_API_URL=https://your-railway-backend.up.railway.app

# ---------------------------------------------------------------------------
# Firebase (copy from your Firebase project console -> Project settings -> Web app)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
